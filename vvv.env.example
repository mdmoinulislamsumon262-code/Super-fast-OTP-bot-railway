BOT_TOKEN=replace_with_your_telegram_bot_token
ADMIN_ID=replace_with_numeric_telegram_admin_id
DATA_DIR=/app/data
# Keep this stable to encrypt stored API keys and temporary-mail credentials.
# If unset, BOT_TOKEN is used as the encryption key source.
# BOT_DATA_ENCRYPTION_KEY=

# Optional SMShadi/Lamix endpoints; requests are refused unless these use HTTPS.
# SMSHADI_URL=
# LAMIX_URL=